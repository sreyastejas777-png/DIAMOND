+            className="w-[360px] sm:w-[400px] h-[480px] sm:h-[530px] max-h-[calc(100vh-180px)] bg-[#FEFAF1] dark:bg-[#0c0c0e] rounded-3xl border border-border shadow-skeuo-out flex flex-col overflow-hidden mb-4 mr-0 sm:mr-2"
+          >
